{
  "name": "@tea/cms-edge",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "app/",
    "db/"
  ],
  "exports": {
    ".": "./app/index.tsx",
    "./content": "./app/entries.ts",
    "./preview": "./app/preview.ts",
    "./schema.sql": "./db/schema.sql"
  },
  "scripts": {
    "dev:example": "wrangler dev --config example/wrangler.jsonc",
    "check:example": "tsc --project tsconfig.json --noEmit && wrangler types example/worker-configuration.d.ts --config example/wrangler.jsonc && tsc --project example/tsconfig.json --noEmit && npm run test:edge",
    "test:edge": "cd ../.. && NODE_ENV=test remix test --type server 'packages/cms-edge/**/*.test.{ts,tsx}'",
    "deploy:example": "wrangler deploy --config example/wrangler.jsonc"
  },
  "dependencies": {
    "@tea/request-body": "0.1.0",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
