{
  "name": "@jackharrhy/tea-maps-renderer",
  "version": "0.1.0",
  "description": "Embeddable WebGPU renderer for Quake, BSP2, GoldSrc, and Quake II maps",
  "homepage": "https://github.com/jackharrhy/tea/tree/main/packages/maps-renderer#readme",
  "bugs": {
    "url": "https://github.com/jackharrhy/tea/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jackharrhy/tea",
    "directory": "packages/maps-renderer"
  },
  "files": [
    "dist",
    "README.md",
    "VIEWER_API.md",
    "format-core.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "import": "./dist/element.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.js"
    },
    "./walkability": {
      "types": "./dist/walkability/index.d.ts",
      "import": "./dist/walkability.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.standalone.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "typegpu": "0.12.5",
    "wgpu-matrix": "^3.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@webgpu/types": "^0.1.72",
    "typescript": "^7.0.2",
    "unplugin-typegpu": "0.12.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
