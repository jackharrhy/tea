{
  "name": "@tea/maps-compiler",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && node --enable-source-maps dist/server.js",
