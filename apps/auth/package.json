{
  "name": "@harrhy/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test __tests__/*.test.mjs",
    "test:browser": "node __tests__/browser/authorization.mjs && node __tests__/browser/radio-enrollment.mjs && node __tests__/browser/access-management.mjs && node __tests__/browser/doodle-gallery.mjs",
    "typecheck": "tsrs --noEmit",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "tsrs": "^0.25.0-ts7.1.0-beta"
  },
  "dependencies": {
    "@harrhy/ui": "^0.1.0",
    "remix": "^3.2.0"
  }
}
