{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tea-maps-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client-dev",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "MAPS_SERVICE_ORIGIN": "http://127.0.0.1:8792",
    "MAPS_COLLABORATION_ORIGIN": "http://127.0.0.1:8787",
    "MAPS_LOCAL_FIXTURE_ORIGIN": "http://127.0.0.1:8793"
  }
}
