{
  "name": "@tea/maps",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build.mjs",
    "build": "npm run build:client && wrangler deploy --dry-run",
    "dev": "node scripts/build.mjs --dev && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:embed": "npm run build --workspace @tea/maps-renderer && node __tests__/embed-flow.mjs",
    "test:gpu": "node __tests__/gpu-flow.mjs",
    "test:corpus:gpu": "node __tests__/gpu-flow.mjs --corpus",
    "test:corpus:gpu:all": "node __tests__/gpu-flow.mjs --corpus-all",
    "test:hosted": "node __tests__/hosted-flow.mjs",
    "corpus:steam": "bash scripts/download-steam-bsp-corpus.sh",
    "archive:goldsrc": "node scripts/archive-goldsrc-server.mjs",
    "corpus:check": "node scripts/check-bsp-corpus.mjs",
    "check": "npm run build:client && npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@tea/maps-editor": "0.1.0",
    "@tea/maps-protocol": "0.1.0",
    "@tea/maps-renderer": "0.1.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
