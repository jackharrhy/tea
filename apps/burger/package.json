{
  "name": "@tea/burger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "vite build",
    "build:server": "NODE_ENV=production bun build server/server.ts --target=bun --outdir dist/server",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production WEB_ROOT=dist/client bun dist/server/server.js",
    "dev": "npm run build && npm run start",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "test": "bun test __tests__/server __tests__/game",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/static": "1.4.12",
    "@tea/burger-core": "0.1.0",
    "bitecs": "0.4.0",
    "debug": "4.4.3",
    "elysia": "1.4.31",
    "jose": "6.2.17",
    "pixi.js": "8.22.0",
    "remix": "3.2.0",
    "tiny-invariant": "1.3.3",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/debug": "4.1.13",
    "@types/node": "^26.6.6",
    "vite": "^8.3.7"
  }
}
