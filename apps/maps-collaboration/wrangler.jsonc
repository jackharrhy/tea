{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tea-maps-collaboration",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "MAP_CELLS", "class_name": "MapCell" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapCell"] }],
}
