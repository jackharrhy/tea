HOST=127.0.0.1
PORT=4351
TEA_DATA_DIR=data
# Optional read-only MCP endpoint at /tea/mcp on each site host.
# TEA_MCP_TOKEN=
# Optional operator dashboard origin (separate from every site origin).
# TEA_OPERATOR_ORIGIN=https://teacms.example.com
# Central Auth mode requires all browser clients and reviewed user auth_subject links.
# TEA_AUTH_ISSUER=https://auth.jackharrhy.dev
# TEA_AUTH_PROJECT_ID=
# TEA_AUTH_ORGANIZATION_ID=
# TEA_AUTH_OPERATOR_CLIENT_ID=
# TEA_AUTH_ANDREW_CLIENT_ID=
# TEA_AUTH_LUKE_CLIENT_ID=
# TEA_AUTH_INTROSPECTION_CLIENT_ID=
# TEA_AUTH_INTROSPECTION_SECRET=
# Set these only while running cms:seed-operator; never commit credentials.
# TEA_OPERATOR_EMAIL=
# TEA_OPERATOR_PASSWORD=
# Set these only when running cms:seed-users; never commit credentials.
# TEA_ADMIN_EMAIL=
# TEA_ADMIN_PASSWORD=
