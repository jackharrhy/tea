{
  "name": "@harrhy/cms",
  "private": true,
  "type": "module",
  "exports": {
    "./sites/*": "./sites/*/app/site.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "typecheck": "tsrs --noEmit",
    "build": "npm run typecheck && NODE_ENV=production node --import remix/node-tsx scripts/check-assets.ts",
    "test": "cd ../.. && NODE_ENV=test remix test --type server 'apps/cms/**/*.test.{ts,tsx}' 'packages/rich-text/**/*.test.{ts,tsx}'",
    "test:browser": "playwright test",
    "cms:seed-users": "node --env-file-if-exists=.env --import remix/node-tsx scripts/seed-users.ts",
    "cms:seed-operator": "node --env-file-if-exists=.env --import remix/node-tsx scripts/seed-operator.ts",
    "link:central-auth": "node --env-file-if-exists=.env --import remix/node-tsx scripts/link-central-auth.ts",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@harrhy/identity": "0.1.0",
    "@harrhy/json-schema": "0.1.0",
    "@harrhy/logger": "0.1.0",
    "@harrhy/mcp": "0.1.0",
    "@harrhy/request-body": "0.1.0",
    "@harrhy/rich-text": "*",
    "bcryptjs": "3.0.3",
    "marked": "18.1.3",
    "morphdom": "2.7.8",
    "remix": "3.2.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
