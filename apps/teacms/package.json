{
  "name": "teacms",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx apps/server/server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx apps/server/server.ts",
    "typecheck": "tsc --noEmit && tsc -p packages/edge/tsconfig.json",
    "build": "npm run typecheck && NODE_ENV=production node --import remix/node-tsx scripts/check-assets.ts",
    "test": "NODE_ENV=test remix test",
    "test:browser": "playwright test",
    "tea:seed-users": "node --env-file-if-exists=.env --import remix/node-tsx scripts/seed-users.ts",
    "tea:seed-operator": "node --env-file-if-exists=.env --import remix/node-tsx scripts/seed-operator.ts",
    "tea:adopt": "node --import remix/node-tsx scripts/adopt.ts",
    "tea:adopt-local": "node --import remix/node-tsx scripts/adopt-local.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run build && npm test",
    "tea:traefik": "node --env-file-if-exists=.env --import remix/node-tsx scripts/traefik.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "remix": "3.0.0"
  }
}
