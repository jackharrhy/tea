HOST=127.0.0.1
PORT=4351
TEA_DATA_DIR=data
# Optional read-only MCP endpoint at /tea/mcp on each site host.
# TEA_MCP_TOKEN=
# Optional operator dashboard origin (separate from every site origin).
# TEA_OPERATOR_ORIGIN=https://teacms.example.com
# Set these only while running tea:seed-operator; never commit credentials.
# TEA_OPERATOR_EMAIL=
# TEA_OPERATOR_PASSWORD=
# Set these only when running tea:seed-users; never commit credentials.
# TEA_ADMIN_EMAIL=
# TEA_ADMIN_PASSWORD=
