{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "remix/assets/types/hmr"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component",
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/teacms/**/*.ts",
    "packages/teacms/**/*.tsx",
    "sites/**/*.ts",
    "sites/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["apps/edge-example"]
}
