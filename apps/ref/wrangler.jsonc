{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tea-ref",
  "main": "worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "DirectoryCell" },
      { "name": "BOARDS", "class_name": "BoardCell" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DirectoryCell", "BoardCell"] },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tea-ref-media" }],
}
