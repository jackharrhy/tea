{
  "name": "@tea/garden",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "typecheck": "tsrs --noEmit",
    "test": "NODE_ENV=test node --import remix/node-tsx --test __tests__/*.test.ts",
    "test:parity": "node --env-file-if-exists=.env --import remix/node-tsx __tests__/parity.ts",
    "check": "npm run typecheck && npm test",
    "content:export": "node --env-file-if-exists=.env --import remix/node-tsx scripts/export.ts",
    "assets:diff": "node scripts/assets.ts diff",
    "assets:check": "node scripts/assets.ts check",
    "assets:missing:local": "node scripts/assets.ts missing-local",
    "assets:missing:remote": "node scripts/assets.ts missing-remote",
    "assets:pull:missing": "node scripts/assets.ts pull-missing",
    "assets:copy:to-r2": "node scripts/assets.ts copy-to-r2",
    "assets:sync:to-r2:dry-run": "node scripts/assets.ts sync-to-r2 --dry-run",
    "assets:sync:to-r2": "node scripts/assets.ts sync-to-r2",
    "linkblog:raindrop:status": "node scripts/linkblog-raindrop.ts status",
    "linkblog:raindrop:write-drafts": "node scripts/linkblog-raindrop.ts write-drafts",
    "linkblog:raindrop:sync-done:dry-run": "node scripts/linkblog-raindrop.ts sync-done",
    "linkblog:raindrop:sync-done": "node scripts/linkblog-raindrop.ts sync-done --apply"
  },
  "dependencies": {
    "@bomb.sh/args": "^0.3.1",
    "@shikijs/rehype": "^4.0.0",
    "hast-util-from-html": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "remark-smartypants": "^3.0.2",
    "remix": "3.2.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "postcss": "^8.5.0",
    "playwright": "^1.60.0",
    "sharp": "^0.35.5"
  }
}
