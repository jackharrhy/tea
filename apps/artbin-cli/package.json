{
  "name": "artbin",
  "version": "0.4.0",
  "description": "CLI for scanning, uploading, downloading, and organizing game assets in artbin",
  "keywords": [
    "cli",
    "game-assets",
    "goldsource",
    "maps",
    "quake",
    "textures"
  ],
  "homepage": "https://github.com/jackharrhy/tea/tree/main/apps/artbin-cli#readme",
  "bugs": {
    "url": "https://github.com/jackharrhy/tea/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackharrhy/tea",
    "directory": "apps/artbin-cli"
  },
  "bin": {
    "artbin": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && tsup",
    "build:ui": "vite build --config ui.vite.config.ts",
    "dev": "tsup --watch",
    "check": "npm run typecheck && npm test && npm run test:publish-policy",
    "test:login-exit": "node __tests__/login-exit.smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:publish-policy": "vitest run scripts/__tests__/publish-policy.test.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@artbin/core": "0.0.1",
    "@artbin/ui": "0.0.1",
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "env-paths": "^4.0.0",
    "open": "^11.0.1",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
