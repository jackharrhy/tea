{
  "name": "@harrhy/artbin",
  "version": "0.4.1",
  "description": "CLI for scanning, uploading, downloading, and organizing game assets in artbin",
  "keywords": [
    "cli",
    "game-assets",
    "goldsource",
    "maps",
    "quake",
    "textures"
  ],
  "homepage": "https://github.com/jackharrhy/harrhy/tree/main/apps/artbin-cli#readme",
  "bugs": {
    "url": "https://github.com/jackharrhy/harrhy/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackharrhy/harrhy.git",
    "directory": "apps/artbin-cli"
  },
  "bin": {
    "artbin": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && tsup",
    "build:ui": "vite build --config ui.vite.config.ts",
    "dev": "tsup --watch",
    "check": "npm run typecheck && npm test && npm run test:publish-policy",
    "test:login-exit": "node __tests__/login-exit.smoke.mjs",
    "typecheck": "tsrs --noEmit",
    "test:publish-policy": "vitest run scripts/__tests__/publish-policy.test.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@harrhy/artbin-core": "0.0.1",
    "@harrhy/artbin-ui": "0.0.1",
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "env-paths": "^4.0.0",
    "open": "^11.0.4",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
