# Required to open the private /steve inbox. The username is always "steve".
STEVE_ADMIN_PASSWORD=replace-with-a-long-random-password

# For the Central Auth cutover, set all seven fields together. Register the exact
# https://steve-letter-writ.ing/auth/callback URI and review both subjects.
# AUTH_ISSUER=https://auth.jackharrhy.dev
# AUTH_CLIENT_ID=
# AUTH_PROJECT_ID=
# AUTH_ORGANIZATION_ID=
# AUTH_PUBLIC_ORIGIN=https://steve-letter-writ.ing
# AUTH_ADMIN_SUBJECT=
# AUTH_RECIPIENT_SUBJECT=

# Optional. Defaults to ./db/letters.sqlite.
DATABASE_PATH=./db/letters.sqlite

# Optional. Defaults to ./tmp/uploads. Keep this outside the public web root.
UPLOAD_DIRECTORY=./tmp/uploads

# Optional. Trust proxy forwarding headers when the app is reachable only through
# a reverse proxy that overwrites them.
TRUST_PROXY=false
