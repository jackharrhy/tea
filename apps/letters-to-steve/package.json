{
  "name": "@tea/letters-to-steve",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "typecheck": "tsrs --noEmit",
    "test": "NODE_ENV=test remix test --type server",
    "check": "npm run typecheck && npm test",
    "db:migrate": "remix db migrate",
    "db:status": "remix db status"
  },
  "dependencies": {
    "@tea/identity": "0.1.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-hard-break": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-italic": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-text": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "remix": "3.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
