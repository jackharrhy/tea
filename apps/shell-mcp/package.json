{
  "name": "@tea/shell-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "start": "node --import remix/node-tsx server.ts",
    "dev": "node --import remix/node-tsx server.ts",
    "demo": "SHELL_MODE=demo node --import remix/node-tsx server.ts",
    "typecheck": "tsrs --noEmit",
    "test": "NODE_ENV=test node --import remix/node-tsx --test __tests__/*.test.ts app/execution/__tests__/*.test.ts app/middleware/__tests__/*.test.ts",
    "test:oauth": "NODE_ENV=test node --import remix/node-tsx --test __tests__/integration/oauth-http.test.ts",
    "smoke": "node --import remix/node-tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {
    "@tea/json-schema": "0.1.0",
    "@tea/logger": "0.1.0",
    "@tea/mcp": "0.1.0",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "26.6.4"
  }
}
