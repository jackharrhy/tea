{
  "name": "@harrhy/lists",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build:assets": "bun build src/campaign-client.ts --target browser --outfile public/campaign.js --minify",
    "dev": "bun run build:assets && bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:local": "LOCAL_E2E=1 bun test __tests__/local-stack.e2e.test.ts --timeout 45000",
    "export:tea": "bun run scripts/export-tea.ts",
    "import:tea": "bun run scripts/import-tea.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint app src __tests__ emails scripts",
    "lint:fix": "oxlint app src __tests__ emails scripts --fix",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "check": "npm run typecheck && bun test __tests__ && npm run build:assets"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/client-sesv2": "^3.1168.0",
    "@aws-sdk/client-sqs": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@harrhy/identity": "^0.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "handlebars": "^4.7.10",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "mailparser": "^3.14.3",
    "marked": "^18.2.0",
    "mjml": "^5.4.1",
    "nodemailer": "^10.5.0",
    "remix": "3.2.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "sns-validator": "^0.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/mjml": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/sns-validator": "^0.3.3",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.17",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
