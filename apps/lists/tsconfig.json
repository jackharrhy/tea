{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun", "node"],
    "jsxImportSource": "remix/component",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["app/**/*", "src/**/*", "emails/**/*", "scripts/**/*"]
}
