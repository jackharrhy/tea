{
  "name": "@harrhy/artbin-app",
  "type": "module",
  "imports": {
    "#db": "./src/db/index.ts",
    "#db/*": "./src/db/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#api/*": "./app/actions/api/handlers/*.ts"
  },
  "scripts": {
    "build": "tsrs --noEmit",
    "dev": "NODE_ENV=development node hmr.ts",
    "dev:watch": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "npm run test:unit && npm run test:remix",
    "test:unit": "vitest run",
    "test:support:browser": "ARTBIN_SUPPORT_BROWSER_TEST=1 vitest run __tests__/support-login.test.ts",
    "test:remix": "remix test --type server --concurrency 1",
    "typecheck": "tsrs --noEmit",
    "check": "npm run typecheck && npm test",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@harrhy/worldview-renderer": "0.2.0",
    "@harrhy/artbin-core": "0.0.1",
    "@harrhy/request-body": "0.1.0",
    "@tus/file-store": "2.1.2",
    "@tus/server": "2.4.7",
    "7zip-bin-full": "^26.6.0",
    "archiver": "^8.0.0",
    "better-result": "^3.0.1",
    "better-sqlite3": "^13.1.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "evlog": "^2.35.1",
    "nanoid": "^6.0.2",
    "playwright": "^1.65.0",
    "poppygl": "^0.0.38",
    "remix": "3.2.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "@harrhy/identity": "0.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
