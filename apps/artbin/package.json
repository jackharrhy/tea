{
  "name": "@tea/artbin",
  "type": "module",
  "imports": {
    "#db": "./src/db/index.ts",
    "#db/*": "./src/db/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#api/*": "./app/actions/api/handlers/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "NODE_ENV=development node hmr.ts",
    "dev:watch": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "npm run test:unit && npm run test:remix",
    "test:unit": "vitest run",
    "test:remix": "remix test --type server --concurrency 1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "7zip-bin-full": "^26.2.1",
    "@artbin/core": "0.0.1",
    "@jackharrhy/worldview": "^0.6.1",
    "@tscircuit/alphabet": "^0.0.26",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.5",
    "archiver": "^8.0.0",
    "better-result": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "evlog": "^2.27.0",
    "nanoid": "^6.0.1",
    "playwright": "^1.62.1",
    "poppygl": "^0.0.28",
    "remix": "3.0.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
