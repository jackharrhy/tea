# 4orm OAuth2 provider (for "Login with 4orm")
FOURM_URL=http://localhost:8000
FOURM_CLIENT_ID=artbin
ARTBIN_URL=http://localhost:5175

# 4orm resource-server OAuth introspection (server-only)
ARTBIN_4ORM_INTROSPECTION_URL=http://localhost:8000/oauth/introspect
ARTBIN_4ORM_INTROSPECTION_CLIENT_ID=artbin-server
ARTBIN_4ORM_INTROSPECTION_SECRET=

# Database path (default: data/artbin.db)
# ARTBIN_DB_PATH=data/artbin.db
