# Jack Auth OIDC client and application boundaries
AUTH_ISSUER=https://auth.jackharrhy.dev
AUTH_CLIENT_ID=
AUTH_PROJECT_ID=
AUTH_ORGANIZATION_ID=
ARTBIN_URL=http://localhost:5175

# Resource-server credentials, kept on the server
AUTH_INTROSPECTION_CLIENT_ID=
AUTH_INTROSPECTION_SECRET=

# Support login stays disabled until Jack Auth's support endpoints and
# the dedicated client/transport binding have been accepted.
ARTBIN_SUPPORT_LOGIN_ENABLED=0
AUTH_SUPPORT_CLIENT_ID=
AUTH_SUPPORT_TRANSPORT_SECRET=

# Database path (default: data/artbin.db)
# ARTBIN_DB_PATH=data/artbin.db
