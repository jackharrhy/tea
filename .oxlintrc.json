{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "rules": {
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": [
    "node_modules/**",
    "apps/cms/tmp/**",
    "apps/cms/data/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ]
}
