{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Celld is a host/container tool; Wrangler is provided by app workspaces in CI.
  "ignoreBinaries": ["celld", "wrangler"],
  "workspaces": {
    "apps/4orm": {
      // HTTPS issuer fixtures generate local ephemeral certificates.
      "ignoreBinaries": ["openssl"],
      "entry": [
        "app/client.ts",
        "app/browser/app.ts",
        "app/browser/codemirror.ts",
        "review-gateway/worker.ts",
        "review-peer/worker.ts",
        "static/sw.js",
        "__tests__/*.mjs",
        "__tests__/*worker.ts",
        "__tests__/cli-loopback-transport.ts",
      ],
    },
    "apps/auth": {
      "entry": [
        "integrations/*.js",
        "tools/doodle-gallery/server.mjs",
        "tools/doodle-gallery/public/*.mjs",
        "tools/doodle-gallery/public/*.css",
      ],
      "ignoreUnresolved": [
        "^\\./doodle-spec\\.mjs$",
        "^/doodle-(webgl|spec)\\.mjs$",
      ],
    },
    "apps/8mb": {
      "entry": ["public/sw.js", "scripts/import-styles.mjs"],
      // The build copies these FFmpeg cores as browser-loadable JavaScript and WASM.
      "ignoreDependencies": ["@ffmpeg/core", "@ffmpeg/core-mt"],
    },
    "apps/cms": {
      "entry": [
        "app/actions/public/entry.ts",
        "sites/*/public/site.js",
        "public/**/*.js",
        "operator/public/**/*.js",
      ],
    },
    "apps/cms-edge": {
      "entry": ["cloudflare.config.ts", "worker.ts"],
    },
    "apps/burger": {
      "entry": ["server/server.ts"],
    },
    "apps/gurgur": {
      "entry": [
        "server/src/index.ts",
        "scripts/cli.ts",
        "scripts/smoke-browser.ts",
        "scripts/setup-trenchbroom.ts",
        "tools/compile-map/src/index.ts",
        "tools/connection-soak.ts",
        "tools/generate-fgd/src/index.ts",
        "tools/network-harness/src/run.ts",
        "tools/network-harness/src/matrix.ts",
        "tools/persistence-soak.ts",
        "tools/physics-soak.ts",
        "tools/render-player-billboard/src/index.ts",
        "web/src/debug-capture-worker.ts",
        "web/src/physics-worker.ts",
        "web/src/speech-worker.ts",
      ],
    },
    "apps/garden": {
      "entry": [
        "app/ui/public/entry.js",
        "app/ui/public/debug.js",
        "scripts/import-styles.mjs",
      ],
      // A type-only JSDoc reference left in the upstream bundled picoCAD viewer.
      "ignoreUnresolved": ["^\\./model-data-parser$"],
    },
    "apps/worldview": {
      "entry": [
        "app/assets/entry.ts",
        "app/assets/editor.ts",
        "app/assets/viewer.ts",
        "scripts/extract-bsp-corpus.mjs",
      ],
      // The embed test serves this URL from its in-process HTTP server.
      "ignoreUnresolved": ["^/standalone\\.js$"],
    },
    "apps/maps-compiler": {
      "entry": ["src/server.ts"],
    },
    "apps/artbin": {
      "entry": [
        "app/actions/public/entry.ts",
        "app/actions/public/bsp-overview-renderer.ts",
        "__tests__/http-identity.ts",
        "app/__tests__/**/*.test.ts",
        "app/actions/**/__tests__/**/*.test.ts",
        "scripts/add-file-counts.ts",
        "scripts/fix-mime-types.ts",
        "scripts/fix-model-kinds.ts",
      ],
    },
    "apps/artbin-cli": {
      "entry": ["scripts/publish.mjs"],
    },
    "apps/letters-to-steve": {
      "entry": ["app/actions/public/entry.ts"],
      // Browser font URLs are served by remix/assets.
      "ignoreDependencies": [
        "@fontsource-variable/literata",
        "@fontsource-variable/shantell-sans",
      ],
    },
    "apps/lists": {
      "entry": ["src/campaign-client.ts"],
    },
    "apps/marky": {
      "entry": ["remix-test.config.ts", "app/assets/entry.ts"],
      // Browser modules resolve this package through remix/assets.
      "ignoreDependencies": ["prosemirror-schema-basic"],
    },
    "apps/pool": {
      "entry": [
        "server/index.ts",
        "server/pre-update.ts",
        "app/game/replay.ts",
        "app/game/audio-lab.ts",
        "scripts/recordings.ts",
        "__tests__/browser/production.ts",
      ],
    },
    "apps/radio": {
      "entry": [
        "app/assets/entry.ts",
        "app/**/__tests__/**/*.test.ts",
        "app/**/__tests__/**/*.test.browser.ts",
        "scripts/prepare-celld.mjs",
      ],
      // The postinstall script copies this font into public assets.
      "ignoreDependencies": ["@material-symbols/font-400"],
    },
    "apps/ref": {
      "entry": [
        "app/assets/board.ts",
        "app/assets/inspector.ts",
        "public/assets/thumb-worker.js",
      ],
      // The dev script starts this package as a separate OAuth process.
      "ignoreDependencies": ["@harrhy/dev-auth"],
    },
    "packages/dev-auth": {
      "entry": ["token.mjs"],
    },
    "packages/pool": {
      // The physical cabinet and gameplay table share the same measured bounds.
      "ignoreIssues": { "src/physical-table.ts": ["duplicates"] },
    },
    "packages/maps-editor": {
      // BrushId is a branded PrimitiveId and intentionally shares its parser.
      "ignoreIssues": { "src/core/runtime-schemas.ts": ["duplicates"] },
    },
  },
}
